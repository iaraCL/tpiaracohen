@model TPFINAL.Models.Clase
@using TPFINAL.Models

@{
    ViewData["Title"] = "Detalle de clase";
}

<h1>@Model.Nombre</h1>

<img src="@("/imagenes/" + Model.Imagen)"
     alt="@Model.Nombre"
     style="width: 300px; height: 200px; object-fit: cover;" />

<p><strong>Categoría:</strong> @Model.Categoria</p>

<p><strong>Descripción:</strong> @Model.Descripcion</p>

<p><strong>Profesor:</strong> @Model.Profesor</p>

<h2>Horarios disponibles</h2>

@foreach (HorarioClase horario in ViewBag.Horarios)
{
    <div class="card mb-3">
        <div class="card-body">
            <p>Fecha: @horario.FechaHora.ToString("dd/MM/yyyy")</p>
            <p>Hora: @horario.FechaHora.ToString("HH:mm")</p>
            <p>Duración: @horario.DuracionMinutos minutos</p>
            <p>Lugares disponibles: @horario.LugaresDisponibles</p>
        </div>
    </div>
}


<a asp-controller="Clases"
   asp-action="Index"
   class="btn btn-secondary">
    Volver al catálogo
</a>
