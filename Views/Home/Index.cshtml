@{
    ViewData["Title"] = "Inicio";
}

<section class="inicio-gimnasio">

    <div class="inicio-contenido">

        <span class="inicio-etiqueta">GIMNASIO FUERZA</span>

        <h1>Tu energía.<br />
            <span>Tu mejor versión.</span>
        </h1>

        <p>
            Entrená a tu ritmo, descubrí nuevas clases y
            reservá tu lugar de forma rápida y sencilla.
        </p>

        
        <div class="inicio-botones">
            <a asp-controller="Clases" asp-action="Index" class="btn btn-primary">
                Ver clases
            </a>
        </div>


    </div>

</section>

<section class="inicio-beneficios">

    <div class="beneficio">
        <h3>Entrená a tu manera</h3>
        <p>Explorá nuestras clases y encontrá la actividad ideal para vos.</p>
    </div>

    <div class="beneficio">
        <h3>Reservas fáciles</h3>
        <p>Elegí el horario que prefieras y reservá tu lugar online.</p>
    </div>

    <div class="beneficio">
        <h3>Organizá tus clases</h3>
        <p>Consultá tus próximas reservas y administralas desde tu cuenta.</p>
    </div>

</section>
